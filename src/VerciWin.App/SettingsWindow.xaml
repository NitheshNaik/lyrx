<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VerciWin.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VerciWin Settings">

    <Grid Background="#12121C" Padding="28">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" MaxWidth="520" HorizontalAlignment="Left">
                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="VerciWin Preferences" FontSize="24" FontWeight="SemiBold" Foreground="#F0F0F8" />
                    <TextBlock Text="Configure kinetic typography overlay, styling, and positioning." FontSize="13" Foreground="#9090A8" />
                </StackPanel>

                <!-- Appearance Card -->
                <Border Background="#1C1C2C" CornerRadius="8" Padding="18" BorderBrush="#2C2C3E" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Foreground="#E0E0EC" />

                        <!-- Visual Style -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Visual Style" FontSize="13" Foreground="#B0B0C0" />
                            <ComboBox x:Name="StyleComboBox" Width="280" SelectionChanged="StyleComboBox_SelectionChanged">
                                <ComboBoxItem Content="Glow (Vibrant Glass &amp; Ambient Blur)" Tag="Glow" />
                                <ComboBoxItem Content="Minimal (Clean Typography)" Tag="Minimal" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Opacity -->
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Overlay Master Opacity" FontSize="13" Foreground="#B0B0C0" HorizontalAlignment="Left" />
                                <TextBlock x:Name="OpacityValueText" Text="100%" FontSize="13" Foreground="#9090C8" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" StepFrequency="0.05" ValueChanged="OpacitySlider_ValueChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Placement & Window Mode Card -->
                <Border Background="#1C1C2C" CornerRadius="8" Padding="18" BorderBrush="#2C2C3E" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Placement &amp; Behavior" FontSize="16" FontWeight="SemiBold" Foreground="#E0E0EC" />

                        <!-- Screen Position -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Screen Placement" FontSize="13" Foreground="#B0B0C0" />
                            <ComboBox x:Name="PositionComboBox" Width="280" SelectionChanged="PositionComboBox_SelectionChanged">
                                <ComboBoxItem Content="Lower Third (Bottom 30% of screen)" Tag="LowerThird" />
                                <ComboBoxItem Content="Center (Focal Center)" Tag="Center" />
                                <ComboBoxItem Content="Full Screen (Cinematic)" Tag="FullScreen" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Overlay Mode Toggle -->
                        <Grid>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Click-Through Overlay Mode" FontSize="13" Foreground="#B0B0C0" />
                                <TextBlock Text="When enabled, overlay is always on top and passes mouse clicks through." FontSize="11" Foreground="#707088" />
                            </StackPanel>
                            <ToggleSwitch x:Name="OverlayModeSwitch" HorizontalAlignment="Right" Toggled="OverlayModeSwitch_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- About Card -->
                <Border Background="#1C1C2C" CornerRadius="8" Padding="18" BorderBrush="#2C2C3E" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="About VerciWin" FontSize="14" FontWeight="SemiBold" Foreground="#E0E0EC" />
                        <TextBlock Text="Windows-native kinetic typography synced via GSMTC &amp; LRCLIB." FontSize="12" Foreground="#808098" />
                        <TextBlock Text="Version: 1.0.0 (WinUI 3 + Win2D Native)" FontSize="11" Foreground="#606078" />
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <Button Content="Close" Click="CloseButton_Click" Width="90" />
                    <Button Content="Apply &amp; Save" Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click" Width="120" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
